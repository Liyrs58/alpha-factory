# Optional NVIDIA NIM. Unset = deterministic mock LLM (M01–M08).
# Key: https://build.nvidia.com/settings  (nvapi-…)
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Model locked: google/gemma-4-31b-it
# Transport: stream:true  timeout: 180s (cold start ~2 min)
NVIDIA_API_KEY=

# Hard-off in code. The app never sends live orders even if this is flipped.
LIVE_TRADING=false

# Optional durable session/universe JSON. Unset = ephemeral data/ + /tmp.
# Create a Blob store on Vercel (Hobby) and paste the token.
BLOB_READ_WRITE_TOKEN=

# Optional demo gate. Unset = public lab.
# When set, /login + AUTH_SECRET-signed HttpOnly cookie (af_gate).
DEMO_ACCESS_CODE=
AUTH_SECRET=

# Paper broker (research book only). off | alpaca
# alpaca + ALPACA_API_KEY/SECRET → https://paper-api.alpaca.markets
# alpaca without keys → offline simulator
# Live hosts (api.alpaca.markets) are refused. Orders only from "Paper submit".
PAPER_BROKER=off
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional override. Default paper-api.alpaca.markets. Live URLs refused.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
