# Optional NVIDIA NIM. Unset = deterministic mock LLM (M01–M08).
# Key: https://build.nvidia.com/settings  (nvapi-…)
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Model locked: google/gemma-4-31b-it
NVIDIA_API_KEY=

# Hard-off in code. The app never sends live orders even if this is flipped.
LIVE_TRADING=false
