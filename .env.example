# Optional NVIDIA NIM (OpenAI-compatible). Unset = deterministic mock LLM (M01–M08).
# Free trial key: https://build.nvidia.com/settings  (nvapi-…)
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Hard-off in code. The app never sends live orders even if this is flipped.
LIVE_TRADING=false
